# LLM Provider Configuration
# Choose 'ollama' (default, local zero-API-key), 'groq', or 'gemini'
LLM_PROVIDER=ollama

# Model IDs (configurable, defaults provided)
# For Ollama: llama3.2, llama3, mistral, phi3
# For Groq: llama-3.1-8b-instant or llama-3.3-70b-versatile
# For Gemini: gemini-1.5-flash or gemini-2.0-flash
LLM_MODEL=llama3.2

# Ollama local endpoint
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (leave blank for local Ollama / offline deterministic fallback)
# On Hugging Face Spaces, configure these in Settings -> Variables and secrets if using Groq/Gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenMP runtime configuration for Windows CPU
KMP_DUPLICATE_LIB_OK=TRUE
